# Is file ki copy banao aur naam rakho ".env" (isi folder mein), phir values bharo.
# ".env" ko KABHI GitHub par upload mat karna aur kisi ko mat bhejna. Sirf ".env.example" GitHub par jaati hai.

NODE_ENV=production
PORT=4000

# --- ZAROORI ---
# MongoDB Atlas ka connection string (README / START-HERE Step A)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/yaari?retryWrites=true&w=majority
# 40+ akshar ka lamba random text (login ko sign karta hai). Kisi ko mat batana.
JWT_SECRET=
# Aapki site ka pata, end mein slash nahi. Laptop par: http://localhost:4000
APP_URL=http://localhost:4000

# --- RAZORPAY (pehle TEST keys: rzp_test_...) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- EMAIL (password reset, email confirmation, SOS alerts ke liye) ---
# SMTP_HOST khali raha to email sirf server ke log mein print hoti hai (user ko nahi jati).
REQUIRE_EMAIL_VERIFY=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Yaari <no-reply@yourdomain.in>"

# --- SOS / ZAROORI ALERTS (admin ko asli notification) ---
# In dono mein se kam se kam ek bharo. Admin accounts ko email waise bhi jata hai (agar SMTP bhara ho).
# Kai emails ho to comma se alag karo:  a@x.com,b@x.com
ALERT_EMAIL=
# Slack / Discord / Telegram-bridge ka webhook URL (optional)
ALERT_WEBHOOK_URL=
# Emergency contact ko SMS (optional). Apne SMS gateway ka URL; server isko {"to":"91XXXXXXXXXX","text":"..."} bhejta hai.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# --- BAAKI ---
REQUIRE_ID_UPLOAD=true
# off | report (sirf browser console mein batata hai, safe) | enforce (pehle payment test karke phir yeh karo)
CSP_MODE=report
